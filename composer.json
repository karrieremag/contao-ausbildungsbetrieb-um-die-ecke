    "license": "GPL-2.0-or-later",
    "homepage": "https://karrieremag.de/siegel.html",
    "authors": [{"name": "Karrieremag GmbH", "homepage": "https://karrieremag.de/"}],
    "support": {"email": "info@karrieremag.de", "docs": "https://karrieremag.de/faq.html#siegel"},
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {"Karrieremag\\AudeBundle\\": "src/"},
